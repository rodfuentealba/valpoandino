---
import AnimatedTagline from '../components/AnimatedTagline'
---

<section
  id="hero"
  class="relative w-full h-screen min-h-[600px] flex items-end overflow-hidden"
>
  <video
    class="absolute inset-0 w-full h-full object-cover"
    autoplay
    muted
    loop
    playsinline
    poster="/assets/hero-poster.jpg"
  >
    <source src="/assets/hero.mp4"  type="video/mp4"  />
  </video>

  <div class="absolute inset-0 bg-black/40"></div>

  <div class="absolute bottom-0 left-0 right-0 z-10 leading-none">
    <div class="px-6 md:px-16 lg:px-24 -mb-5 md:-mb-14">

      <AnimatedTagline client:idle />

      <h1 class="text-white dark:text-zinc-900">
        <span class="block text-7xl md:text-[10rem] lg:text-[12rem] font-light tracking-tight leading-none">
          valparaíso
        </span>
        <span class="block text-7xl md:text-[10rem] lg:text-[12rem] font-black tracking-tight leading-none">
          Andino.
        </span>
      </h1>

    </div>
  </div>
</section>
