---
import BaseLayout from '../layouts/BaseLayout.astro'
import Navbar from '../components/Navbar'
import Hero from '../sections/Hero.astro'
import Andinos from '../sections/Andinos'
import Servicios from '../sections/Servicios'
import Chilcas from '../sections/Chilcas'
import Testimonial from '../sections/Testimonial'
import Collab from '../sections/Collab'
import Footer from '../sections/Footer.astro'
import '../styles/global.css'
---

<BaseLayout>
  <Navbar client:load />
  <Hero />
  <Andinos client:visible />
  <Servicios client:visible />
  <Chilcas client:visible />
  <Collab client:visible />
  <Testimonial client:visible />
  <Footer />
</BaseLayout>
