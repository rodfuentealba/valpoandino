---
import Analytics from '@vercel/analytics/astro';
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ValpoAndino — Escalada en Roca | Deportes de Montaña en Valparaíso</title>
    <meta name="description" content="ValpoAndino: experiencias de escalada en roca y deportes de montaña en la Región de Valparaíso, Chile. Equipo autónomo de andinistas y escaladores. ¿Deseas aprender a escalar en roca?" />
    <meta name="keywords" content="ValpoAndino, escalada en roca, deportes montaña, andinismo, valparaiso, chile, aprender a escalar" />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="ValpoAndino" />

    <meta property="og:title" content="ValparaísoAndino — Escalada en Roca | Deportes de Montaña" />
    <meta property="og:description" content="Experiencias de escalada en roca y deportes de montaña en Valparaíso, Chile. Equipo autónomo de andinistas y escaladores." />
    <meta property="og:image" content="https://valparaisoandino.cl/img/og-image.jpg" />
    <meta property="og:image:secure_url" content="https://valparaisoandino.cl/img/og-image.jpg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:url" content="https://valparaisoandino.cl" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CL" />
    <meta property="og:site_name" content="ValparaísoAndino" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="ValparaísoAndino — Escalada en Roca | Deportes de Montaña" />
    <meta name="twitter:description" content="Participa en los talleres de escalada en roca de Valparaíso Andino Expediciones, guiado por escaladores con más de 10 años de trayectoria. Nuestro equipo está dedicado a brindarle un ambiente que fomente la autosuperación y el crecimiento personal." />
    <meta name="twitter:image" content="https://valparaisoandino.cl/img/og-image.jpg" />

    <link rel="canonical" href="https://valparaisoandino.cl" />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Organization",
        "name": "ValparaísoAndino",
        "url": "https://valparaisoandino.cl",
        "logo": "https://valparaisoandino.cl/img/og-image.jpg",
        "sameAs": ["https://www.instagram.com/valparaiso_andino"],
        "description": "Participa en los talleres de escalada en roca de Valparaíso Andino Expediciones, guiado por escaladores con más de 10 años de trayectoria. Nuestro equipo está dedicado a brindarle un ambiente que fomente la autosuperación y el crecimiento personal."
      }
    </script>

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;700&display=swap" rel="stylesheet" />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: 'Poppins', 'Segoe UI', system-ui, -apple-system, sans-serif;
        height: 100dvh;
        overflow: hidden;
        background: #0a0a0a;
      }

      .video-bg {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
      }

      .overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: linear-gradient(
          to bottom,
          rgba(0, 0, 0, 0.6),
          rgba(0, 0, 0, 0.4)
        );
        z-index: 1;
      }

      .content {
        position: relative;
        z-index: 2;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100dvh;
        text-align: center;
        padding: 1.5rem;
        animation: fadeIn 1s ease-out;
      }

      @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to   { opacity: 1; transform: translateY(0); }
      }

      .logo {
        max-width: min(180px, 40vw);
        height: auto;
        margin-bottom: 1.5rem;
        filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.3));
      }

      h1 {
        color: #fff;
        font-size: clamp(1rem, 3.5vw, 2rem);
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        line-height: 1.4;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: baseline;
        gap: 0.4rem 0.8rem;
      }

      h1 .sep {
        color: rgba(255, 255, 255, 0.4);
        font-weight: 300;
      }

      .subtitle {
        color: rgba(255, 255, 255, 0.8);
        font-size: clamp(0.85rem, 2vw, 1.15rem);
        margin-top: 0.75rem;
        letter-spacing: 0.12em;
        font-weight: 300;
      }

      .cta {
        color: #fff;
        font-size: clamp(0.9rem, 2.2vw, 1.25rem);
        margin-top: 1.5rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        padding: 0.6rem 1.5rem;
        border: 1.5px solid rgba(255, 255, 255, 0.6);
        border-radius: 2rem;
        display: inline-block;
        transition: background 0.3s, border-color 0.3s;
      }

      .social-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 2rem;
        color: rgba(255, 255, 255, 0.8);
        text-decoration: none;
        font-size: clamp(0.8rem, 1.8vw, 1.1rem);
        font-weight: 300;
        letter-spacing: 0.05em;
        transition: color 0.2s, transform 0.2s;
      }

      .social-link:hover {
        color: #fff;
        transform: scale(1.05);
      }

      .social-link svg {
        width: 24px;
        height: 24px;
        flex-shrink: 0;
      }

      .building {
        color: #fff;
        font-size: clamp(0.6rem, 1.1vw, 0.75rem);
        margin-top: 1.5rem;
        letter-spacing: 0.15em;
        font-weight: 700;
        text-transform: uppercase;
        background: #f59e0b;
        padding: 0.3rem 1rem;
        border-radius: 999px;
        display: inline-block;
      }

      .divider {
        width: clamp(40px, 8vw, 80px);
        height: 2px;
        background: rgba(255, 255, 255, 0.6);
        margin: 1.25rem auto;
        border-radius: 2px;
      }

      @media (prefers-reduced-motion: reduce) {
        .content { animation: none; }
      }

      @media (max-width: 480px) {
        .content { padding: 1rem; }
        .logo { max-width: 120px; margin-bottom: 0.75rem; }
        h1 { gap: 0.2rem 0.5rem; font-size: clamp(0.85rem, 4vw, 1.2rem); }
        .subtitle { font-size: clamp(0.75rem, 3vw, 0.9rem); margin-top: 0.5rem; }
        .cta { font-size: 0.8rem; padding: 0.4rem 1rem; margin-top: 1rem; }
        .social-link { margin-top: 1rem; }
        .building { margin-top: 1rem; font-size: 0.6rem; }
      }

      @media (orientation: landscape) and (max-height: 500px) {
        .content { flex-direction: row; gap: 1rem; padding: 0.75rem 1.5rem; flex-wrap: wrap; justify-content: center; }
        .logo { max-width: 60px; margin-bottom: 0; }
        .text-group { text-align: left; }
        .subtitle { margin-top: 0.3rem; }
        .cta { margin-top: 0.5rem; padding: 0.3rem 1rem; font-size: 0.8rem; }
        .social-link { margin-top: 0.3rem; }
      }
    </style>
  </head>
  <body>
    <video
      class="video-bg"
      autoplay
      muted
      loop
      playsinline
      webkit-playsinline
      preload="metadata"
      poster="/img/poster.jpg"
    >
      <source src="/video/background.mp4" type="video/mp4" />
    </video>
    <div class="overlay"></div>

    <div class="content">
      <img
        class="logo"
        src="/img/logo.png"
        alt="ValpoAndino"
        width="400"
        height="400"
      />
      <div class="text-group">
        <h1>
          <span>EXPERIENCIAS</span><span class="sep">|</span>
          <span>ESCALADA EN ROCA</span><span class="sep">|</span>
          <span>DEPORTES EN MONTA&Ntilde;A</span>
        </h1>
        <p class="subtitle">Equipo aut&oacute;nomo de andinistas y escaladores</p>
        <p class="cta">¿Deseas aprender a escalar en roca?</p>
      </div>
      <a class="social-link" href="https://www.instagram.com/valparaiso_andino" target="_blank" rel="noopener noreferrer">
        <svg viewBox="0 0 264.583 264.583" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
          <path d="M132.345 33.973c-26.716 0-30.07.117-40.563.594-10.472.48-17.62 2.136-23.876 4.567-6.47 2.51-11.958 5.87-17.426 11.335-5.472 5.464-8.834 10.948-11.354 17.412-2.44 6.252-4.1 13.397-4.57 23.858-.47 10.486-.593 13.838-.593 40.535 0 26.697.119 30.037.594 40.522.482 10.465 2.14 17.609 4.57 23.859 2.515 6.465 5.876 11.95 11.346 17.414 5.466 5.468 10.955 8.834 17.42 11.345 6.26 2.431 13.41 4.088 23.881 4.567 10.493.477 13.844.594 40.559.594 26.719 0 30.061-.117 40.555-.594 10.472-.48 17.63-2.136 23.888-4.567 6.468-2.51 11.948-5.877 17.414-11.345 5.472-5.464 8.834-10.949 11.354-17.412 2.419-6.252 4.079-13.398 4.57-23.858.472-10.486.595-13.828.595-40.525s-.123-30.047-.594-40.533c-.492-10.465-2.152-17.608-4.57-23.858-2.521-6.466-5.883-11.95-11.355-17.414-5.472-5.468-10.944-8.827-17.42-11.335-6.271-2.431-13.424-4.088-23.897-4.567-10.493-.477-13.834-.594-40.558-.594zm-8.825 17.715c2.62-.004 5.542 0 8.825 0 26.266 0 29.38.094 39.752.565 9.591.438 14.797 2.04 18.264 3.385 4.591 1.782 7.864 3.912 11.305 7.352 3.443 3.44 5.575 6.717 7.362 11.305 1.346 3.46 2.951 8.663 3.388 18.247.47 10.363.573 13.475.573 39.71 0 26.233-.102 29.346-.573 39.709-.44 9.584-2.042 14.786-3.388 18.247-1.783 4.587-3.919 7.854-7.362 11.292-3.443 3.441-6.712 5.57-11.305 7.352-3.463 1.352-8.673 2.95-18.264 3.388-10.37.47-13.486.573-39.752.573-26.268 0-29.38-.102-39.751-.573-9.592-.443-14.797-2.044-18.267-3.39-4.59-1.781-7.87-3.911-11.313-7.352-3.443-3.44-5.574-6.709-7.362-11.298-1.346-3.461-2.95-8.663-3.387-18.247-.472-10.363-.566-13.476-.566-39.726s.094-29.347.566-39.71c.438-9.584 2.04-14.786 3.387-18.25 1.783-4.588 3.919-7.865 7.362-11.305 3.443-3.441 6.722-5.57 11.313-7.357 3.468-1.351 8.675-2.949 18.267-3.389 9.075-.41 12.592-.532 30.926-.553zm61.337 16.322c-6.518 0-11.805 5.277-11.805 11.792 0 6.512 5.287 11.796 11.805 11.796 6.517 0 11.804-5.284 11.804-11.796 0-6.513-5.287-11.796-11.805-11.796zm-52.512 13.782c-27.9 0-50.519 22.603-50.519 50.482 0 27.879 22.62 50.471 50.52 50.471s50.51