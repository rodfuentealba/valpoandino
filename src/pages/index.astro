---
import BaseLayout from '../layouts/BaseLayout.astro'
import '../styles/global.css'
---

<BaseLayout>
  <main class="min-h-screen flex flex-col items-center justify-center gap-4 px-4">
    <h1 class="text-5xl font-extrabold text-red-400 tracking-tight">
      Valparaíso Andino
    </h1>
    <p class="text-lg font-light text-zinc-400">
      Escalada en Roca · Deportes en Montaña
    </p>
    <ul class="text-sm text-zinc-400 dark:text-zinc-600 text-center space-y-1 mt-4">
      <li>✓ Astro 5</li>
      <li>✓ React + TypeScript</li>
      <li>✓ Tailwind — darkMode: class</li>
      <li>✓ Nohemi (fuente local)</li>
      <li>✓ Nanostores</li>
    </ul>
  </main>
</BaseLayout>
