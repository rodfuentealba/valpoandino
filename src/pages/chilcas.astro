---
import BaseLayout from '../layouts/BaseLayout.astro'
import Navbar from '../components/Navbar'
import ChilcasHero from '../sections/ChilcasHero'
import ChilcasContent from '../sections/ChilcasContent'
import Footer from '../sections/Footer.astro'
import { es } from '../i18n/index'
import '../styles/global.css'
---

<BaseLayout title="Escalada en Las Chilcas (Llay-Llay) — Guía y Sectores | Valparaíso Andino" description={es.chilcasPage.metaDesc}>
  <Navbar client:load />
  <ChilcasHero client:load />
  <ChilcasContent client:visible mapboxToken={import.meta.env.PUBLIC_MAPBOX_TOKEN} />
  <Footer />
</BaseLayout>
